---
import GalaxyBackground from "../components/GalaxyBackground.astro";
import "../styles/global.css"; // Ensure your Tailwind/Global styles still load
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 - Err</title>
  </head>
  <body class="bg-white dark:bg-[#010409] overflow-hidden">
    <GalaxyBackground />

    <div class="relative z-10 min-h-screen flex flex-col items-center justify-center px-4 text-center">
      <div class="fuzzy-container mb-8">
        <canvas id="fuzzy-404"></canvas>
      </div>

      <h1 class="text-2xl md:text-3xl font-bold mb-6 dark:text-white uppercase tracking-tighter">
        Error 404: Page doesn't exist
      </h1>
      
      <p class="text-gray-500 dark:text-gray-400 max-w-md mb-10 leading-relaxed">
        The route you're trying to access doesn't exist.
      </p>

      <a href="/" class="group flex items-center gap-2 text-sm font-black uppercase tracking-[0.2em] text-yellow-600 dark:text-yellow-500 no-underline px-8 py-4 border border-yellow-500/20 rounded-full hover:bg-yellow-500/10 transition-all">
        <span class="transition-transform duration-300 group-hover:-translate-x-2">←</span>
        Return to Neural Hive
      </a>
    </div>

    <script>
      class FuzzyText {
        constructor(canvasId, text, options = {}) {
          this.canvas = document.getElementById(canvasId);
          if (!this.canvas) return;
          this.ctx = this.canvas.getContext('2d');
          this.text = text;
          
          this.options = {
            fontSize: 'clamp(5rem, 15vw, 12rem)',
            fontWeight: 900,
            color: '#fbbf24',
            fuzzRange: 40,
            baseIntensity: 0.2,
            hoverIntensity: 0.8,
            glitchProbability: 0.03, // Small chance of glitching per frame
            ...options
          };

          this.isHovering = false;
          this.intensity = this.options.baseIntensity;
          this.init();
        }

        async init() {
          const temp = document.createElement('span');
          temp.style.fontSize = this.options.fontSize;
          document.body.appendChild(temp);
          const numericSize = parseFloat(window.getComputedStyle(temp).fontSize);
          document.body.removeChild(temp);

          const fontString = `${this.options.fontWeight} ${numericSize}px Inter, sans-serif`;
          await document.fonts.ready;

          this.offscreen = document.createElement('canvas');
          const oCtx = this.offscreen.getContext('2d');
          oCtx.font = fontString;
          
          const metrics = oCtx.measureText(this.text);
          const width = Math.ceil(metrics.width) + 20;
          const height = numericSize * 1.2;

          this.offscreen.width = width;
          this.offscreen.height = height;
          oCtx.font = fontString;
          oCtx.textBaseline = 'middle';
          oCtx.fillStyle = this.options.color;
          oCtx.fillText(this.text, 10, height / 2);

          this.canvas.width = width + this.options.fuzzRange * 2;
          this.canvas.height = height;
          
          this.addListeners();
          this.render();
        }

        addListeners() {
          window.addEventListener('mousemove', (e) => {
            const rect = this.canvas.getBoundingClientRect();
            this.isHovering = (
              e.clientX >= rect.left && 
              e.clientX <= rect.right && 
              e.clientY >= rect.top && 
              e.clientY <= rect.bottom
            );
          });
        }

        render() {
          let targetIntensity = this.isHovering ? this.options.hoverIntensity : this.options.baseIntensity;
          
          // Random Glitch Effect logic
          if (Math.random() < this.options.glitchProbability) {
            targetIntensity = 1.5; // High intensity glitch
          }

          this.intensity += (targetIntensity - this.intensity) * 0.15;

          this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

          for (let i = 0; i < this.offscreen.height; i++) {
            const dx = (Math.random() - 0.5) * this.options.fuzzRange * this.intensity;
            this.ctx.drawImage(
              this.offscreen, 
              0, i, this.offscreen.width, 1, 
              this.options.fuzzRange + dx, i, this.offscreen.width, 1
            );
          }

          requestAnimationFrame(() => this.render());
        }
      }

      new FuzzyText('fuzzy-404', '404');
    </script>

    <style>
      .fuzzy-container {
        filter: drop-shadow(0 0 25px rgba(251, 191, 36, 0.3));
      }
      /* Ensure full screen height and no scrolling */
      body, html {
        height: 100%;
        margin: 0;
        padding: 0;
      }
    </style>
  </body>
</html>